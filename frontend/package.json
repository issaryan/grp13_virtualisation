{
  "name": "quiz-application",
  "private": true,
  "scripts": {
    "build": "ng build --prod",
    "ng": "../node_modules/.bin/ng",
    "start": "../node_modules/.bin/ng serve --host 0.0.0.0 --port 4200 --disable-host-check",
    "backend": "node ../backend/serverless.yml",
    "dev": "../node_modules/.bin/concurrently \"npm run start\" \"npm run backend\"",
