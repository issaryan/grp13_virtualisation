    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "rxjs": "^7.8.1",
    "serverless": "^4.14.1",
    "serverless-localstack": "^1.3.1",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
